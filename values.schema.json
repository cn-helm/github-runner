{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "dind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "startupTimeoutSeconds": {"type": "integer", "minimum": 1},
        "extraEnv": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "not": {"enum": ["DOCKER_TLS_CERTDIR", "DOCKER_HOST"]}}}}},
        "resources": {"type": "object"}
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "existingSecret", "tokenKey"],
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "token": {"type": "string"},
        "existingSecret": {"type": "string"},
        "tokenKey": {"type": "string", "minLength": 1}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "labels", "workDir", "initVersion", "sha256"],
      "properties": {
        "maintenance": {"type": "boolean"},
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]*$"},
        "labels": {"type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$"},
        "workDir": {"type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*$", "not": {"enum": ["bin", "externals"]}},
        "initVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^(sha256:[a-fA-F0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": {"type": "string"},
        "size": {"type": "string", "minLength": 1},
        "storageClass": {"type": ["string", "null"]},
        "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany"]}},
        "retain": {"type": "boolean"}
      }
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "not": {"properties": {"name": {"enum": ["DOCKER_HOST", "RUNNER_DOCKER_WAIT_SECONDS"]}}, "required": ["name"]},
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "not": {"enum": ["GITHUB_REPO", "GITHUB_RUNNER_TOKEN", "RUNNER_NAME", "RUNNER_LABELS", "RUNNER_WORK_DIR", "RUNNER_INIT_VERSION", "RUNNER_SHA256", "RUNNER_PERSISTENT_DIR", "RUNNER_PACKAGE_DIR", "RUNNER_APT_CACHE_DIR", "RUNNER_MANUALLY_TRAP_SIG"]}}
        },
        "oneOf": [
          {"required": ["value"], "properties": {"value": {"type": "string"}}, "not": {"required": ["valueFrom"]}},
          {"required": ["valueFrom"], "properties": {"valueFrom": {"type": "object"}}, "not": {"required": ["value"]}}
        ]
      }
    },
    "nodeSelector": {
      "type": "object",
      "required": ["kubernetes.io/os", "kubernetes.io/arch"],
      "properties": {
        "kubernetes.io/os": {"const": "linux"},
        "kubernetes.io/arch": {"const": "amd64"}
      }
    }
  }
}
